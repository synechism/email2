DATABASE_URL=postgres://postgres:postgres@localhost:5432/email_scraper
BETTER_AUTH_SECRET=development-secret-change-before-production
BETTER_AUTH_URL=http://localhost:3000

NYLAS_API_KEY=replace_me
NYLAS_CLIENT_ID=replace_me
NYLAS_API_URI=https://api.us.nylas.com
NYLAS_REDIRECT_URI=http://localhost:3000/api/nylas/callback
NYLAS_DEFAULT_PROVIDER=google
NYLAS_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.readonly
NYLAS_SCRAPE_PAGE_SIZE=50
NYLAS_SCRAPE_MAX_PAGES_PER_RUN=20
NYLAS_SCRAPE_REQUEST_DELAY_MS=250

# Background queues
REDIS_URL=redis://localhost:6379
EMAIL_DISCOVERY_WORKER_CONCURRENCY=2
EMAIL_DISCOVERY_JOB_PAGE_BATCH_SIZE=1
EMAIL_CLASSIFICATION_WORKER_CONCURRENCY=6
EMAIL_CLASSIFICATION_JOB_BATCH_SIZE=20

# Model-backed thread classification. The app tries Azure first, OpenAI second,
# DeepSeek's Anthropic-compatible endpoint third, then a local fallback.
AZURE_API_KEY=replace_me
AZURE_OPENAI_BASE_URL=https://cronwell-codex-2.openai.azure.com/openai/v1
AZURE_OPENAI_MODEL=gpt-5.5
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-4.1-mini
OPENAI_CLASSIFY_BATCH_SIZE=20
MODEL_REASONING_EFFORT=low
MODEL_TEXT_VERBOSITY=low
MODEL_CLASSIFY_MAX_OUTPUT_TOKENS=3000
MODEL_CLASSIFY_TIMEOUT_MS=60000
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=replace_me
ANTHROPIC_MODEL=deepseek-v4-pro[1m]
